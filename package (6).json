{
  "name": "ghcp-agent-migrator",
  "version": "0.1.0",
  "description": "CLI and Copilot skill package for migrating Copilot Studio Standard harness agents into GHCP/NLA agent designs.",
  "private": false,
  "type": "module",
  "bin": {
    "ghcp-agent-migrator": "./bin/ghcp-agent-migrator.mjs"
  },
  "scripts": {
    "start": "node ./bin/ghcp-agent-migrator.mjs",
    "detect": "node ./bin/ghcp-agent-migrator.mjs detect",
    "analyze": "node ./bin/ghcp-agent-migrator.mjs analyze",
    "generate": "node ./bin/ghcp-agent-migrator.mjs generate",
    "install-scaffold": "node ./bin/ghcp-agent-migrator.mjs install",
    "nla-create": "node ./bin/ghcp-agent-migrator.mjs nla-create",
    "commit-builder-response": "node ./bin/ghcp-agent-migrator.mjs commit-builder-response",
    "create-agent-dataverse": "node ./scripts/create-agent-in-dataverse.cjs",
    "package-cowork": "powershell -ExecutionPolicy Bypass -File ./scripts/package-cowork.ps1"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
